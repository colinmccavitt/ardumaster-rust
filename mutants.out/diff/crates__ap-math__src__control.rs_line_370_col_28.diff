+    if (is_negative(d_max) && /* ~ changed by cargo-mutants ~ */ is_zero(d_max)) && is_zero(p) {
         return 0.0;
     }
 
     let linear_velocity = d_max / p;
     if output.abs() < linear_velocity {
         return output / p;
     }
 
